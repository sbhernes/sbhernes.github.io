---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {topics,topicFor,readingMinutes,summaryFor} from '../../lib/topics';
const posts=(await getCollection('blog',p=>!p.data.draft)).filter(p=>!['contact','disclaimer','test'].includes(p.slug));
const displayPosts=posts.map(p=>({post:p,topic:topicFor(p.slug,p.data.title),minutes:readingMinutes(p.body)}));
---
<Base title="Articles" description="Technical field notes on VMware, virtualization, VCF and infrastructure automation.">
<section class="listing-hero listing-hero-redesigned"><div class="container"><div class="eyebrow"><span class="status-dot"></span> THE VIRTUALVIKING ARCHIVE</div><h1>Ideas, lessons &<br /><em>field notes.</em></h1><p>Things that worked, things that broke, and everything learned in between. Hands-on writing from the world of virtualization and private cloud.</p><div class="archive-stats"><div><strong>{posts.length}</strong><span>Technical posts</span></div><div><strong>04</strong><span>Core topics</span></div><div><strong>100%</strong><span>From the field</span></div></div></div></section>
<section class="container articles-section redesigned-archive"><div class="archive-toolbar"><div><span class="eyebrow">EXPLORE THE ARCHIVE</span><h2>All articles<span class="heading-dot">.</span></h2></div><label class="search-wrap"><span aria-hidden="true">⌕</span><input id="article-search" type="search" placeholder="Search articles…" autocomplete="off" aria-label="Search articles" /></label></div>
<div class="topic-filters" role="group" aria-label="Filter by topic">{topics.map((topic,i)=><button type="button" class:list={['topic-filter',{'is-active':i===0}]} data-topic={topic.id} aria-pressed={i===0}>{topic.label}</button>)}</div>
<div class="results-row"><span id="result-count">{posts.length} articles</span><span>Knowledge shared, one lesson at a time.</span></div>
<div class="article-grid" id="article-grid">
{displayPosts.map(({post,topic,minutes})=><a class="article-card" data-topic={topic.id} data-search={`${post.data.title} ${summaryFor(post.data.description,post.body)} ${post.slug} ${topic.label}`.toLowerCase()} href={`/${post.slug}/`}><div class="card-image">{post.data.cover?<img src={post.data.cover} alt="" loading="lazy" />:<span class="card-placeholder">ᚢ</span>}<span class="card-image-shade"></span></div><div class="card-body"><div class="card-topline"><span class="card-kicker">{topic.label}</span><span>{minutes} min</span></div><h3>{post.data.title}</h3><p>{summaryFor(post.data.description,post.body)}</p><span class="card-link">Read field note <span aria-hidden="true">↗</span></span></div></a>)}
</div><p class="empty-state" id="no-results" hidden>No matching articles. Try another search or topic.</p></section>
<script is:inline>
const search=document.querySelector('#article-search'),cards=[...document.querySelectorAll('#article-grid .article-card')],count=document.querySelector('#result-count'),empty=document.querySelector('#no-results'),filters=[...document.querySelectorAll('.topic-filter')];
const params=new URLSearchParams(location.search);const initial=params.get('q');if(initial)search.value=initial;
let topic=params.get('topic')||'all';if(!filters.some(b=>b.dataset.topic===topic))topic='all';
function filter(){const q=search.value.trim().toLowerCase();let matches=0;for(const card of cards){const show=(topic==='all'||card.dataset.topic===topic)&&card.dataset.search.includes(q);card.hidden=!show;if(show)matches++}count.textContent=matches+' '+(matches===1?'article':'articles');empty.hidden=matches!==0;filters.forEach(b=>{const active=b.dataset.topic===topic;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))})}
filters.forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.topic;filter()}));search.addEventListener('input',filter);filter();
</script>
</Base>
