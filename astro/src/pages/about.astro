---
import Base from '../layouts/Base.astro';
---
<Base title="About Sondre" description="Meet Sondre Hernes, the person behind VirtualViking — VMware, private cloud and a passion for learning by doing.">
  <section class="article-top">
    <div class="container" style="padding:76px 0 65px;max-width:880px">
      <span class="eyebrow"><span class="status-dot"></span> ABOUT VIRTUALVIKING</span>
      <h1>Hi, I'm <em>Sondre.</em></h1>
      <p class="article-intro">I'm Sondre Hernes from Norway. I work with VMware technologies, virtualization and private cloud, and I've been part of the VMware vExpert community for three years.</p>
      <span class="topic-pill" style="display:inline-block;margin-top:15px">VMware vExpert · 3 years</span>
    </div>
  </section>
  <section class="container" style="padding:62px 0 92px;max-width:880px">
    <div class="prose">
      <p>I started VirtualViking to share hands-on experiences, lab experiments and the things I learn while solving real infrastructure problems.</p>
      <p>Outside of IT, I enjoy cycling, skiing, golf and spending time outdoors.</p>
    </div>
    <a class="primary-button" href="/blog/" style="margin-top:20px">Read my articles <span aria-hidden="true">↗</span></a>
  </section>
</Base>
