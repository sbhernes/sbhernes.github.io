---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {topicFor,readingMinutes,summaryFor} from '../lib/topics';

const posts=(await getCollection('blog',p=>!p.data.draft)).filter(p=>!['contact','disclaimer','test'].includes(p.slug));
const latest=[...posts].filter(p=>p.data.publishedAt).sort((a,b)=>
  b.data.publishedAt!.getTime()-a.data.publishedAt!.getTime()
).slice(0,3);
const dateLabel=(date:Date)=>new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(date);
---
<Base title="VirtualViking — Sondre Hernes on VMware & Private Cloud" description="I'm Sondre Hernes, a VMware vExpert sharing hands-on lessons from virtualization, private cloud and automation.">
  <section class="hero hero-v2"><div class="container hero-content"><div class="hero-copy">
    <div class="eyebrow"><span class="status-dot"></span> HEY, I'M SONDRE HERNES · VMWARE VEXPERT</div>
    <h1>I build, break<br />& <em>figure things out.</em></h1>
    <p>I'm Sondre, a virtualization enthusiast working with VMware, private cloud and automation. VirtualViking is my little corner of the internet where I share what I'm building, the problems I run into, and what I learn along the way.</p>
    <div class="hero-actions"><a class="primary-button" href="/blog/">Read my articles <span>↗</span></a><a class="text-button" href="/vexpert/">Get to know me →</a></div>
    <div class="hero-facts"><span><strong>{posts.length}</strong> notes shared</span><span class="hero-fact-divider"></span><span><strong>VMware</strong> vExpert</span><span class="hero-fact-divider"></span><span><strong>Always</strong> learning</span></div>
  </div>
  <div class="hero-workbench" aria-hidden="true"><div class="workbench-top"><span class="workbench-dots"><i></i><i></i><i></i></span><span>sondre / virtualviking</span><span>⌁</span></div><div class="workbench-code"><div><span class="line-no">01</span><span class="code-purple">passion</span>: <span class="code-green">"private-cloud"</span></div><div><span class="line-no">02</span><span class="code-purple">platform</span>: <span class="code-green">"VMware VCF"</span></div><div><span class="line-no">03</span><span class="code-purple">my_approach</span>:</div><div><span class="line-no">04</span>&nbsp;&nbsp;- <span class="code-blue">get curious</span></div><div><span class="line-no">05</span>&nbsp;&nbsp;- <span class="code-blue">try it out</span></div><div><span class="line-no">06</span>&nbsp;&nbsp;- <span class="code-blue">share the lessons</span></div><div class="code-comment"><span class="line-no">07</span># plundering the old ways</div></div><div class="workbench-footer"><span class="status-dot"></span> ALWAYS EXPLORING <span>⚔</span></div></div>
  </div></section>

  <section class="container spotlight spotlight-v2"><div class="section-heading"><div>
    <span class="eyebrow">FRESH FROM MY NOTES</span><h2>My latest articles<span class="heading-dot">.</span></h2>
    <p class="section-subtitle">The latest things I've been working on, troubleshooting and learning.</p>
  </div><a href="/blog/">View all articles ↗</a></div>
    <div class="article-grid homepage-grid">{latest.map(post=><a class="article-card" href={`/${post.slug}/`}>
      <div class="card-image">{post.data.cover?<img src={post.data.cover} alt="" loading="lazy" />:<span class="card-placeholder">VV</span>}</div>
      <div class="card-body"><div class="card-topline"><span class="card-kicker">{topicFor(post.slug,post.data.title).label}</span><span>{dateLabel(post.data.publishedAt!)}</span></div><h3>{post.data.title}</h3><p>{summaryFor(post.data.description,post.body)}</p><span class="card-link">Read article <span aria-hidden="true">↗</span></span></div>
    </a>)}</div>
    <p class="all-articles-link"><a href="/blog/">Browse all {posts.length} articles <span aria-hidden="true">↗</span></a></p>
  </section>

  <section class="topics-section topics-v2"><div class="container"><div class="topic-section-header"><div><span class="eyebrow">WHAT I WRITE ABOUT</span><h2>The things that keep<br />me <em>curious.</em></h2></div><p>Most of my posts start with a real problem, a question I can't leave alone, or something new I want to test in the lab.</p></div><div class="topic-grid">
    <a href="/blog/?topic=vcf"><span class="topic-number">01 / PRIVATE CLOUD</span><h3>VMware Cloud Foundation</h3><p>Deployments, upgrades and the lessons I pick up building private cloud environments.</p><span class="topic-arrow">↗</span></a>
    <a href="/blog/?topic=vsphere"><span class="topic-number">02 / VIRTUALIZATION</span><h3>vSphere & ESXi</h3><p>Everyday troubleshooting, useful discoveries and the odd head-scratching issue.</p><span class="topic-arrow">↗</span></a>
    <a href="/blog/?topic=automation"><span class="topic-number">03 / AUTOMATION</span><h3>Making things easier</h3><p>APIs, Ansible and little experiments that save time the next time around.</p><span class="topic-arrow">↗</span></a>
  </div></div></section>

  <section class="about-banner"><div class="container about-banner-inner"><div><span class="eyebrow">A LITTLE MORE ABOUT ME</span><h2>Nice to meet you<span class="heading-dot">.</span></h2><p>I'm Sondre Hernes, a VMware vExpert from Norway who enjoys turning tricky infrastructure challenges into something worth sharing. This blog is part notebook, part learning journey — and hopefully useful to someone solving the same problems.</p></div><a class="primary-button" href="/vexpert/">My story ↗</a></div></section>
</Base>
