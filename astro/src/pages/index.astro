---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {topicFor,readingMinutes} from '../lib/topics';
const posts=(await getCollection('blog',p=>!p.data.draft)).filter(p=>!['contact','disclaimer','test'].includes(p.slug));
const priority=['deployment-vcf-9','vmware-explore-2025-las-vegas','vcf-automation-overview'];
const featured=priority.map(s=>posts.find(p=>p.slug===s)).filter(Boolean);
const lead=featured[0];
const other=featured.slice(1);
---
<Base title="VirtualViking — Private Cloud & Virtualization" description="Technical field notes on VMware, VCF, virtualization and automation by Sondre Hernes.">
  <section class="hero hero-v2"><div class="container hero-content"><div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> INDEPENDENT TECH JOURNAL · BY SONDRE HERNES</div><h1>Built in the lab.<br /><em>Shared with the world.</em></h1><p>Real-world notes on VMware, private cloud, and the automation that makes infrastructure better. No buzzwords, just lessons worth sharing.</p><div class="hero-actions"><a class="primary-button" href="/blog/">Explore the field notes <span>↗</span></a><a class="text-button" href="/vexpert/">About the author →</a></div><div class="hero-facts"><span><strong>{posts.length}</strong> technical notes</span><span class="hero-fact-divider"></span><span><strong>04</strong> topic areas</span><span class="hero-fact-divider"></span><span><strong>VMware</strong> vExpert</span></div></div>
  <div class="hero-workbench" aria-hidden="true"><div class="workbench-top"><span class="workbench-dots"><i></i><i></i><i></i></span><span>virtualviking / infrastructure</span><span>⌁</span></div><div class="workbench-code"><div><span class="line-no">01</span><span class="code-purple">platform</span>: <span class="code-green">"private-cloud"</span></div><div><span class="line-no">02</span><span class="code-purple">foundation</span>: <span class="code-green">"VCF 9"</span></div><div><span class="line-no">03</span><span class="code-purple">approach</span>:</div><div><span class="line-no">04</span>&nbsp;&nbsp;- <span class="code-blue">learn</span></div><div><span class="line-no">05</span>&nbsp;&nbsp;- <span class="code-blue">build</span></div><div><span class="line-no">06</span>&nbsp;&nbsp;- <span class="code-blue">automate</span></div><div class="code-comment"><span class="line-no">07</span># plundering the old ways</div></div><div class="workbench-footer"><span class="status-dot"></span> ALL SYSTEMS EXPLORING <span>ᚢ</span></div></div>
  </div></section>
  <section class="container spotlight spotlight-v2"><div class="section-heading"><div><span class="eyebrow">SELECTED FIELD NOTES</span><h2>From the lab<span class="heading-dot">.</span></h2><p class="section-subtitle">Deep dives and lessons from projects, conferences and late-night troubleshooting.</p></div><a href="/blog/">Explore the archive ↗</a></div>
  {lead&&<a class="featured-story" href={`/${lead.slug}/`}><div class="featured-art">{lead.data.cover?<img src={lead.data.cover} alt="" loading="lazy" />:<span class="featured-rune">ᚢ</span>}<span class="featured-overlay">FEATURED GUIDE</span></div><div class="featured-copy"><span class="eyebrow">{topicFor(lead.slug,lead.data.title).label} / DEEP DIVE</span><h3>{lead.data.title}</h3><p>{lead.data.description}</p><div class="featured-footer"><span>{readingMinutes(lead.body)} min read</span><strong>Read the walkthrough ↗</strong></div></div></a>}
  <div class="article-grid homepage-grid">{other.map(post=><a class="article-card" href={`/${post.slug}/`}><div class="card-image">{post.data.cover?<img src={post.data.cover} alt="" loading="lazy" />:<span class="card-placeholder">ᚢ</span>}</div><div class="card-body"><div class="card-topline"><span class="card-kicker">{topicFor(post.slug,post.data.title).label}</span><span>{readingMinutes(post.body)} min</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="card-link">Read field note ↗</span></div></a>)}<a class="browse-card" href="/blog/"><span class="eyebrow">THE ARCHIVE</span><span class="browse-symbol">↗</span><h3>More stories.<br />More discoveries.</h3><p>Explore all {posts.length} technical notes across cloud, vSphere, automation and community.</p><strong>Browse all articles →</strong></a></div>
  </section>
  <section class="topics-section topics-v2"><div class="container"><div class="topic-section-header"><div><span class="eyebrow">THE MAIN THEMES</span><h2>Things I like<br />to <em>figure out.</em></h2></div><p>From building modern private cloud foundations to finding the one setting that makes everything click.</p></div><div class="topic-grid"><a href="/blog/?topic=vcf"><span class="topic-number">01 / PRIVATE CLOUD</span><h3>VMware Cloud Foundation</h3><p>Deployment, lifecycle and the details that matter in real environments.</p><span class="topic-arrow">↗</span></a><a href="/blog/?topic=vsphere"><span class="topic-number">02 / VIRTUALIZATION</span><h3>vSphere & ESXi</h3><p>Troubleshooting, operations and lessons from the hypervisor layer.</p><span class="topic-arrow">↗</span></a><a href="/blog/?topic=automation"><span class="topic-number">03 / MAKE IT REPEATABLE</span><h3>Automation</h3><p>APIs, Ansible and reliable workflows that take toil out of infrastructure.</p><span class="topic-arrow">↗</span></a></div></div></section>
  <section class="about-banner"><div class="container about-banner-inner"><div><span class="eyebrow">THE PERSON BEHIND THE POSTS</span><h2>Hi, I'm Sondre<span class="heading-dot">.</span></h2><p>Virtualization enthusiast, VMware vExpert and believer in learning by building. VirtualViking is where I share what I discover along the way.</p></div><a class="primary-button" href="/vexpert/">More about me ↗</a></div></section>
</Base>
