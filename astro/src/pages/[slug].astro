---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {topicFor,readingMinutes,summaryFor} from '../lib/topics';
type Props={post:any};
export async function getStaticPaths(){const posts=await getCollection('blog',p=>!p.data.draft);return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;
const {Content,headings}=await post.render();
const topic=topicFor(post.slug,post.data.title);
const readTime=readingMinutes(post.body);
const summary=summaryFor(post.data.description,post.body);
const toc=headings.filter(h=>h.depth===2||h.depth===3);
const publicationDate=post.data.publishedAt as Date|undefined;
const formattedDate=publicationDate?new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(publicationDate):null;
---
<Base title={post.data.title} description={summary} canonicalPath={`/${post.slug}`}>
<div class="article-top"><div class="container article-masthead"><a class="back" href="/blog/">← Back to articles</a><h1>{post.data.title}</h1><div class="article-meta" style="margin-bottom:24px"><a class="topic-pill" href={`/blog/?topic=${topic.id}`}>{topic.label}</a><span class="meta-separator">·</span><span>{readTime} min read</span>{publicationDate&&<><span class="meta-separator">·</span><time datetime={publicationDate.toISOString().slice(0,10)}>Published {formattedDate}</time></>}</div><p class="article-intro">{summary}</p><div class="author-line"><span class="author-avatar">SH</span><div><strong>Sondre Hernes</strong><span>Virtualization & private cloud</span></div></div></div></div>
<div class="article-layout container"><article class="prose" id="article-content"><Content /><div class="end-note"><span class="eyebrow">END OF FIELD NOTE</span><h3>Keep exploring.</h3><p>More practical lessons and technical deep dives from the VirtualViking lab.</p><a class="primary-button" href="/blog/">Browse all articles ↗</a></div></article><aside class="article-aside"><div class="article-sidebar-inner">{toc.length>0&&<nav class="toc-card" aria-label="On this page"><span class="eyebrow">ON THIS PAGE</span><ol>{toc.map(h=><li class:list={{'toc-sub':h.depth===3}}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>}<div class="aside-card"><span class="eyebrow">ABOUT THE AUTHOR</span><h3>Sondre Hernes</h3><p>VMware vExpert sharing field-tested lessons on VCF, vSphere and infrastructure automation.</p><a href="/about/">About Sondre ↗</a></div></div></aside></div>
</Base>
