---
interface Props { title: string; description?: string; canonicalPath?: string }
const {title,description='',canonicalPath=Astro.url.pathname}=Astro.props;
const canonical=new URL(canonicalPath,'https://virtualviking.blog').toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#091321" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="VirtualViking" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/assets/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="stylesheet" href="/assets/enhancements.css" />
  <title>{title} · VirtualViking</title>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header"><div class="nav-wrap">
    <a class="brand" href="/" aria-label="VirtualViking home"><span class="brand-icon"><img src="/assets/favicon.svg?v=2" width="41" height="41" alt="" /></span><span>VIRTUAL<span class="brand-accent">VIKING</span></span></a>
    <button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
    <nav class="site-nav" aria-label="Main navigation"><a href="/">Home</a><a href="/blog/">Articles</a><a href="/vexpert/">About</a><a href="/contact/">Contact</a></nav>
  </div></header>
  <main id="content"><slot /></main>
  <footer class="footer"><div class="container footer-grid"><div><a class="brand" href="/"><span class="brand-icon"><img src="/assets/favicon.svg?v=2" width="41" height="41" alt="" /></span><span>VIRTUAL<span class="brand-accent">VIKING</span></span></a><p>Plundering the Old Ways, Automating the New.</p></div><div><p>Virtualization · Private cloud · Automation</p><p>© 2026 Sondre Hernes</p></div></div></footer>
  <script src="/assets/site.js" defer></script>
</body>
</html>
